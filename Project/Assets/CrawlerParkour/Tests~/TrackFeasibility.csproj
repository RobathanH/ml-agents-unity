<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the real ParkourBox / ParkourTrackGenerator against a minimal
    UnityEngine shim so track generation can be validated without the editor.
    Run with:  dotnet run -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>TrackFeasibility</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityShim.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="../Scripts/ParkourBox.cs" />
    <Compile Include="../Scripts/ParkourTrackGenerator.cs" />
  </ItemGroup>
</Project>
